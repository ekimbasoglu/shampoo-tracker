{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome", // or "msedge" for Edge
      "request": "launch",
      "name": "Debug Vite App",
      "url": "http://localhost:5173", // Ensure this matches your Vite dev server port
      "webRoot": "${workspaceFolder}/src", // Adjust to your project's source root
      "sourceMaps": true,
      "runtimeArgs": ["--remote-debugging-port=9222"] // Optional: for attaching other tools
    }
  ]
}
